# ─────────────────────────────────────────────
# Discord ComVis — Environment Variables
# Copy to .env and fill in your values
# ─────────────────────────────────────────────

# Discord Bot Token (required for data collection)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Gemini API Key (required for Slow Route AI analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# Database
# Local dev:  sqlite+aiosqlite:///./data/discord_comvis.db
# Railway:    postgresql+asyncpg://USER:PASS@HOST:PORT/DBNAME
DATABASE_URL=sqlite+aiosqlite:///./data/discord_comvis.db

# Auth
JWT_SECRET=change-me-in-production-use-a-long-random-string
ADMIN_PASSWORD=Test2525
VIEWER_PASSWORD=LookSys555

# CORS — add your Vercel frontend URL (comma-separated)
# e.g. https://your-app.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
