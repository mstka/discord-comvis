# ─────────────────────────────────────────────────────────────────────────────
# backend/.env — FastAPI コンテナの環境変数
# cp backend/.env.example backend/.env  してから値を入力してください
# docker-compose が DATABASE_URL を上書きするため、DB設定は不要です
# ─────────────────────────────────────────────────────────────────────────────

# Discord Bot Token（データ収集に必要）
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Gemini API Key（Slow Route AI 判定に必要）
GEMINI_API_KEY=your_gemini_api_key_here

# Auth
JWT_SECRET=replace_with_long_random_string_32chars_minimum
ADMIN_PASSWORD=Test2525
VIEWER_PASSWORD=LookSys555

# ── 以下は docker-compose.yml が上書きするため通常変更不要 ──────────────────
# DATABASE_URL は docker-compose で postgres コンテナに向けられます
# DATABASE_URL=postgresql+asyncpg://comvis:password@postgres:5432/discord_comvis

HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Slow Route 係数（デフォルト値のまま変更不要）
SLOW_ALPHA=0.35
SLOW_BETA=0.25
SLOW_GAMMA=0.25
SLOW_DELTA=0.15
SLOW_LAMBDA_DEFAULT=0.10
SLOW_LAMBDA_INCIDENT=0.05
SLOW_LAMBDA_CASUAL=0.30

# 判定閾値
EDGE_CONFIDENCE_THRESHOLD=0.30
OPEN_SOCKET_TIMEOUT_HOURS=48
