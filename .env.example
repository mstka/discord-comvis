# ─────────────────────────────────────────────────────────────────────────────
# docker-compose 用の環境変数テンプレート
# cp .env.example .env  してから値を入力してください
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL root password (docker-compose が postgres/backend コンテナに渡す)
POSTGRES_PASSWORD=change_me_strong_password
